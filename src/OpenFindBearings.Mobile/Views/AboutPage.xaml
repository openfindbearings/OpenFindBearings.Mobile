<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             x:Class="OpenFindBearings.Mobile.Views.AboutPage"
             Title="我的">
    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">
        <Label Text="{Binding Status}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
        <toolkit:SfButton Text="登录" Command="{Binding LoginCommand}" IsVisible="{Binding IsAuthenticated, Converter={StaticResource InverseBool}}" />
        <toolkit:SfButton Text="退出登录" Command="{Binding LogoutCommand}" IsVisible="{Binding IsAuthenticated}" BackgroundColor="#FF6B6B" />
    </VerticalStackLayout>
</ContentPage>
