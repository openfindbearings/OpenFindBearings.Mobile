<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             x:Class="OpenFindBearings.Mobile.Views.InquiryPage"
             Title="查询">
    <VerticalStackLayout Padding="16" Spacing="12">
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="轴承型号关键字">
            <Entry x:Name="KeywordEntry" Placeholder="如 6204" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfButton Text="搜索" Clicked="OnSearchClicked" />
        <CollectionView x:Name="Results">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout>
                            <Label Text="{Binding PartNumber}" Style="{StaticResource TitleLabel}" />
                            <Label Text="{Binding BrandName}" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
