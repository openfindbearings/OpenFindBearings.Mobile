<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             x:Class="OpenFindBearings.Mobile.Views.RegisterPage"
             Title="注册">
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
        <Label Text="注册账号" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="手机号">
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="密码">
            <Entry Text="{Binding Password}" IsPassword="True" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="确认密码">
            <Entry Text="{Binding ConfirmPassword}" IsPassword="True" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfButton Text="注册" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <toolkit:SfButton Text="返回登录" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="#512BD4" />
    </VerticalStackLayout>
</ContentPage>
