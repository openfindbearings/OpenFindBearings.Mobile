<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="OpenFindBearings.Mobile.Views.LoginPage"
             Title="登录">
    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
        <Label Text="OpenFindBearings" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="手机号密码登录" FontSize="14" TextColor="#888" HorizontalOptions="Center" />
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="手机号">
            <Entry Text="{Binding Phone}" Keyboard="Telephone" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfTextInputLayout ContainerType="Outlined" Hint="密码">
            <Entry Text="{Binding Password}" IsPassword="True" />
        </toolkit:SfTextInputLayout>
        <toolkit:SfButton Text="登录" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <toolkit:SfButton Text="注册新账号" Command="{Binding GoRegisterCommand}" BackgroundColor="Transparent" TextColor="#512BD4" />
    </VerticalStackLayout>
</ContentPage>
